{
  "name": "@retail/superadmin",
  "version": "1.0.0",
  "scripts": {
    "dev": "DOTENV_CONFIG_PATH=../../.env ts-node-dev -r dotenv/config --respawn --transpile-only src/server.ts",
    "build": "tsc --build",
    "start": "node dist/server.js",
    "grant-superadmin": "DOTENV_CONFIG_PATH=../../.env ts-node -r dotenv/config scripts/grant-superadmin.ts"
  },
  "dependencies": {
    "@retail/config":     "*",
    "@retail/db":         "*",
    "@retail/middleware": "*",
    "@retail/redis":      "*",
    "@retail/types":      "*",
    "@supabase/supabase-js": "^2.110.3",
    "express":            "^4.19.2",
    "helmet":             "^7.1.0",
    "dotenv":             "^16.4.5",
    "zod":                "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "ts-node-dev":    "^2.0.0"
  }
}
