{
  "name": "@retail/realtime",
  "version": "1.0.0",
  "scripts": {
    "dev": "DOTENV_CONFIG_PATH=../../.env ts-node-dev -r dotenv/config --respawn --transpile-only src/server.ts",
    "build": "tsc --build",
    "start": "node dist/server.js",
    "test": "NODE_ENV=development DOTENV_CONFIG_PATH=../../.env vitest run"
  },
  "dependencies": {
    "@retail/config":         "*",
    "@retail/db":             "*",
    "@retail/middleware":     "*",
    "@retail/redis":          "*",
    "@retail/supabase-admin": "*",
    "@retail/types":          "*",
    "express":            "^4.19.2",
    "helmet":             "^7.1.0",
    "dotenv":             "^16.4.5",
    "socket.io":          "^4.7.5",
    "node-cron":          "^3.0.3"
  },
  "devDependencies": {
    "@types/express":  "^4.17.21",
    "@types/node-cron": "^3.0.11",
    "ts-node-dev":     "^2.0.0",
    "vitest":           "^1.6.0"
  }
}
