# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# Per-service: override PORT in each service's process / docker-compose entry
PORT=3000

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Option A — full URL (preferred for production / Heroku / Railway / Supabase)
DATABASE_URL=postgres://retail_app:change_me@localhost:5432/retail_saas

# Option B — discrete vars (used when DATABASE_URL is absent)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retail_saas
DB_USER=retail_app
DB_PASSWORD=change_me_in_production
DB_SSL=false

# ─── Redis ────────────────────────────────────────────────────────────────────
# General purpose (idempotency, rate-limit, cache)
REDIS_URL=redis://localhost:6379

# BullMQ queue connection (can point to a separate Redis instance)
BULLMQ_REDIS_URL=redis://localhost:6379

# ─── JWT (asymmetric RS256) ───────────────────────────────────────────────────
# Generate a key pair:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste PEM content as a single-line string with \n newlines, or use a secrets manager.
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_EXPIRY=1h

# Refresh token HMAC secret (min 32 chars)
REFRESH_TOKEN_SECRET=replace_with_32_plus_char_random_secret
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Tenant / Auth header names ───────────────────────────────────────────────
TENANT_CONTEXT_HEADER=x-tenant-id
AUTH_HEADER=authorization

# ─── Twilio WhatsApp Business API ────────────────────────────────────────────
WHATSAPP_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_AUTH_TOKEN=your_auth_token
WHATSAPP_FROM_NUMBER=+14155238886

# ─── Service Ports (set PORT per service in docker-compose or systemd) ────────
# auth-tenant:     3001
# inventory:       3002
# sales-sync:      3003
# ledger-payments: 3004
# whatsapp-engine: 3005
