# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# Per-service: override PORT in each service's process / docker-compose entry
PORT=3000

# ─── Supabase ────────────────────────────────────────────────────────────────
# Cluster auth verifies Supabase-issued JWTs against the JWKS endpoint.
# SUPABASE_SECRET_KEY is the service-role key — server-side ONLY, never ship it
# to a client. Find these in Dashboard → Project Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Expected audience claim on Supabase access tokens (GoTrue default)
SUPABASE_JWT_AUD=authenticated

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Option A — full URL (preferred for production / Heroku / Railway / Supabase)
# Supabase direct:  postgresql://postgres:[PASSWORD]@db.<project-ref>.supabase.co:5432/postgres
# Supabase pooler:  postgresql://postgres.<project-ref>:[PASSWORD]@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://retail_app:change_me@localhost:5432/retail_saas

# Option B — discrete vars (used when DATABASE_URL is absent)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retail_saas
DB_USER=retail_app
DB_PASSWORD=change_me_in_production
# Supabase requires TLS — set DB_SSL=true (or no-verify for the pooler) for Supabase
DB_SSL=false

# Eager auto-migrate on service boot. Keep false — apply migrations once with
# `npm run migrate`. Set true only for a single designated migrator/local dev.
DB_AUTO_MIGRATE=false

# ─── Redis ────────────────────────────────────────────────────────────────────
# General purpose (idempotency, rate-limit, cache)
REDIS_URL=redis://localhost:6379

# BullMQ queue connection (can point to a separate Redis instance)
BULLMQ_REDIS_URL=redis://localhost:6379

# ─── JWT (asymmetric RS256 — auth-tenant token minting only) ─────────────────
# Downstream services verify Supabase JWKS; only auth-tenant needs these to mint.
# Generate a key pair:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste PEM content as a single-line string with \n newlines, or use a secrets manager.
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_EXPIRY=1h

# Refresh token HMAC secret (min 32 chars)
REFRESH_TOKEN_SECRET=replace_with_32_plus_char_random_secret
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Tenant / Auth header names ───────────────────────────────────────────────
TENANT_CONTEXT_HEADER=x-tenant-id
AUTH_HEADER=authorization

# ─── Twilio WhatsApp Business API ────────────────────────────────────────────
WHATSAPP_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_AUTH_TOKEN=your_auth_token
WHATSAPP_FROM_NUMBER=+14155238886

# ─── Service Ports (set PORT per service in docker-compose or systemd) ────────
# auth-tenant:     3001
# inventory:       3002
# sales-sync:      3003
# ledger-payments: 3004
# whatsapp-engine: 3005
